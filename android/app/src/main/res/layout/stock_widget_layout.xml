<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自選股"
        android:textColor="#63718A"
        android:textSize="11sp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/name1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/price1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/change1"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9AA6B6"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/name2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/price2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/change2"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9AA6B6"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/name3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/price3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/change3"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9AA6B6"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/name4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/price4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/change4"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9AA6B6"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/name5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/price5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F2F5F9"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/change5"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9AA6B6"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

</LinearLayout>
